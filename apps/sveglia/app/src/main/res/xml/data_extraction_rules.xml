<?xml version="1.0" encoding="utf-8"?>
<!-- Nessun backup cloud né trasferimento tra dispositivi: le sveglie restano sul telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="device_root" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="device_root" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
