<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- tema scuro del kit "Arancio UI"; il colore principale scelto nelle impostazioni è applicato da Ui.apply -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">#FFD96D00</item>
        <item name="android:colorControlNormal">#FFA39E95</item>
        <item name="android:textColorPrimary">#FFEDEAE3</item>
        <item name="android:textColorSecondary">#FFA39E95</item>
        <item name="android:fontFamily">@font/jbmono</item>
    </style>

    <!-- selettore dell'orario a rotella -->
    <style name="WheelTimePicker" parent="@android:style/Widget.Material.TimePicker">
        <item name="android:timePickerMode">spinner</item>
    </style>
</resources>
